{
  "name": "static-resource-downloader",
  "version": "1.0.0",
  "description": "Electron 网站静态资源下载器（CDP Network）",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist:win": "pnpm build && electron-builder --win nsis --x64",
    "preview": "electron-vite preview",
    "mirror:rewrite": "node scripts/rewrite-mirror.mjs",
    "mirror:rewrite:dry": "node scripts/rewrite-mirror.mjs --dry",
    "serve": "go run main.go",
    "download:serve": "go run scripts/serve-download-index.go",
    "cubemap:demo": "node scripts/tiles-to-cubemap.mjs",
    "cubemap:view": "npx --yes serve demo -l 3456",
    "pano:batch": "node scripts/pano-folder-batch.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "engines": {
    "node": "^18.0.0 || >=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "electron": "^35.0.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^3.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.1"
  },
  "build": {
    "appId": "com.justeasy.downloadvr",
    "productName": "DownloadVR",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "form-data-encoder": "^4.1.0",
    "formdata-node": "^6.0.3",
    "express": "^5.2.1",
    "replace-in-file": "^8.4.0",
    "yazl": "^3.3.1"
  }
}
